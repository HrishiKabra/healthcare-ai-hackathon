# Which AI provider the server uses by default: mock | anthropic | ollama
AI_PROVIDER=mock

# Cloud provider (only used when AI_PROVIDER=anthropic). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# On-device provider (only used when AI_PROVIDER=ollama and the app runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TRANSLATE_MODEL=

# When true, every route uses canned mock responses no matter what AI_PROVIDER says.
DEMO_MODE=true
